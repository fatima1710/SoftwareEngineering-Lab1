<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab2.LoginController">
   <children>
      <Label layoutX="272.0" layoutY="102.0" text="User Login" />
      <TextField fx:id="emailField" layoutX="226.0" layoutY="128.0" promptText="Email" />
      <PasswordField fx:id="passwordField" layoutX="226.0" layoutY="188.0" promptText="Password" />
      <Button layoutX="274.0" layoutY="224.0" mnemonicParsing="false" onAction="#handleLogin" text="Login" />
      <Label fx:id="errorLabel" alignment="CENTER" layoutX="150.0" layoutY="258.0" prefHeight="17.0" prefWidth="300.0" textFill="RED" />
   </children>
</AnchorPane>
